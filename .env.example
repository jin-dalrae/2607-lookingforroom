# Gemini / Google AI (for filter.py scoring)
AI_MODEL=gemini-3.5-flash
GCP_KEY=
generative_language_api_key=

# Alert notifications (choose Telegram or Slack in run.py --alert-channel)
TELEGRAM_BOT_TOKEN=
# Optional if you use bot.py /start (saved to telegram_chat.json instead)
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# Gmail — OAuth2 (recommended) or App Password fallback
# OAuth: enable Gmail API in GCP → python oauth_setup.py once
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_ADDRESS=
# App Password fallback (NOT your regular Gmail password)
# Setup: enable 2FA → https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=