# --- Optional: Gemini cloud scoring (off by default) ---
# Local heuristics score listings with no API key.
# USE_GEMINI=1
# GCP_KEY=
# AI_MODEL=gemini-2.0-flash

# --- Optional: Gmail for drafts / reply monitoring ---
# OAuth (recommended): enable Gmail API → python oauth_setup.py
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_ADDRESS=
# App Password fallback (not your normal Gmail password)
GMAIL_APP_PASSWORD=

# --- Optional: public API URL (Cloudflare Tunnel / deploy) ---
# APPLY_API_PUBLIC_URL=https://your-tunnel.example.com
# APPLY_API_TOKEN=
